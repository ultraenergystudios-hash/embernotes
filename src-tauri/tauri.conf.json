{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.2.0",
  "identifier": "io.baekgaard.ember",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ember",
        "url": "index.html",
        "width": 980,
        "height": 720,
        "minWidth": 560,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#131316"
      },
      {
        "label": "capture",
        "create": false,
        "title": "Ember — Quick add",
        "url": "capture.html",
        "width": 680,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "reminder",
        "create": false,
        "title": "Ember — Reminder",
        "url": "reminder.html",
        "width": 380,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ultraenergystudios-hash/embernotes/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QTk5OTZERDcwNDAwOUQKUldTZEFBVFhiWm1wYWU2bGVKRXZaUFJWVVU0a1k3RVVGV3JPdnBIZTk0VTVCT00xTkFwRGovdnMK"
    }
  }
}
